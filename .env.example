# JobAgent Environment Variables Example
# Copy this file to .env and fill in your actual values

# Database Configuration
# PostgreSQL credentials for the RAG pipeline vector store
POSTGRES_USER=your_postgres_username
POSTGRES_PASSWORD=your_postgres_password

# Google AI API Configuration
# Get your API key from: https://ai.google.dev/gemini-api/docs/api-key
GOOGLE_API_KEY=your_google_ai_api_key


# Optional: LangSmith Configuration for Tracing
# Get your API key from: https://docs.smith.langchain.com/
# LANGSMITH_API_KEY=your_langsmith_api_key
# LANGSMITH_TRACING=true

# Browser Automation Configuration (Optional)
# Chrome executable path (uncomment if needed)
# CHROME_EXECUTABLE_PATH=/usr/bin/google-chrome-stable

# Job Scraping Configuration (Optional)
# Default job search parameters (can be overridden via CLI)
# DEFAULT_JOB_TERMS="Machine Learning"
# DEFAULT_LOCATION="Germany"
# DEFAULT_NUM_JOBS=20
